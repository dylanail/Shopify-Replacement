# ── Kiln control plane ─────────────────────────────────────────────
# Leave DATABASE_URL unset to use embedded PGlite at ./.data/kiln (zero-config dev).
# DATABASE_URL=postgres://kiln:kiln@localhost:5432/kiln
CORE_PORT=4000
JWT_SECRET=change-me-in-production
ORCHESTRATOR_SECRET=change-me-too
PUBLIC_CORE_URL=http://localhost:4000
ADMIN_URL=http://localhost:3000
STOREFRONT_BASE_DOMAIN=localhost:3001

# ── AI ─────────────────────────────────────────────────────────────
# Without a key Kiln falls back to the deterministic offline planner (demo mode).
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...           # image generation / enhancement lanes
KILN_DEFAULT_MODEL=claude-sonnet-5

# ── Payments / email (all optional; Kiln degrades to test providers) ──
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_CONNECT_CLIENT_ID=ca_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# RESEND_API_KEY=re_...
EMAIL_FROM=Kiln <noreply@kiln.local>
