# Copy to .env. Everything except AMBORAS_SECRET is optional; without a model
# key the rules writers stand in and the admin says so.

# --- required in any real deployment -------------------------------------
# Master key for password hashing, sealed credentials and visitor fingerprints.
AMBORAS_SECRET=change-me-to-a-long-random-string

# --- hosts (docker-compose + Caddy) ----------------------------------------
# The admin answers here. Point an A record at the server.
AMBORAS_ADMIN_HOST=admin.yourbrand.com
# Stores answer at <slug>.<this>. Point a wildcard A record (*.stores.yourbrand.com) at the server.
AMBORAS_STOREFRONT_HOST=stores.yourbrand.com
# What custom domains CNAME to. Defaults to edge.<AMBORAS_STOREFRONT_HOST>; point it at the server too.
AMBORAS_EDGE_HOST=edge.stores.yourbrand.com
# The server's public IP, for registrars that need an A record at the apex.
AMBORAS_EDGE_IP=
# Where forwarded domains redirect to when there is no storefront host.
AMBORAS_PUBLIC_ORIGIN=https://admin.yourbrand.com
# Let's Encrypt account email for Caddy.
ACME_EMAIL=you@example.com

# --- models ----------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Which family answers when both keys are set: anthropic | openai
AMBORAS_TEXT_PROVIDER=anthropic
# Model ids live here, not in code.
AMBORAS_MODEL=claude-opus-5
AMBORAS_OPENAI_MODEL=gpt-5
# Pin one task: AMBORAS_MODEL_RESEARCH=anthropic:claude-fable-5-1 (tasks: PLANNER RESEARCH BRAND PAGES ADS EXTRACTION)

# --- images ----------------------------------------------------------------
# OPENAI_API_KEY above also enables GPT Image 2.
AMBORAS_IMAGE_MODEL=gpt-image-2
GEMINI_API_KEY=
AMBORAS_GOOGLE_IMAGE_MODEL=gemini-3-pro-image-preview
# openai | google | svg
AMBORAS_IMAGE_PROVIDER=

# --- ads, email ------------------------------------------------------------
META_AD_LIBRARY_TOKEN=
AMBORAS_AD_LIBRARY_COUNTRY=GB
RESEND_API_KEY=
AMBORAS_EMAIL_DOMAIN=

# --- misc ------------------------------------------------------------------
AMBORAS_LOG_LEVEL=info
