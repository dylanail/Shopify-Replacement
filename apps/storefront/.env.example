# Server-side core URL (used by Next server components / route handlers)
CORE_URL=http://localhost:4000
# Browser-side core URL (client components call the public API directly)
NEXT_PUBLIC_CORE_URL=http://localhost:4000
# Base domain for subdomain tenancy: <slug>.<base>. On localhost the /s/<slug> path form is used.
STOREFRONT_BASE_DOMAIN=localhost:3001
# Optional: overrides the publishable key returned by the core shell (paymentMode "stripe")
STRIPE_PUBLISHABLE_KEY=
